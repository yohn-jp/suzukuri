{
  "name": "suzukuri",
  "version": "0.1.0",
  "description": "Deterministic bounded semantic projections for CLI and library consumers.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "suzukuri": "dist/cli-entry.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "start": "node dist/index.js",
    "test": "node --test --import tsx src/**/*.test.ts scripts/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts' 'scripts/**/*.mjs' 'eslint.config.mjs'",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "smoke-test": "node scripts/smoke-test.mjs",
    "conformance:report": "node scripts/conformance-report.mjs",
    "conformance": "pnpm run build && pnpm run conformance:report",
    "test:package": "pnpm run build && node scripts/run-package-suite.mjs",
    "governance:actions": "node scripts/validate-actions.mjs",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test && pnpm run governance:actions && pnpm run test:package",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript-eslint": "8.67.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yohn-jp/suzukuri.git"
  },
  "homepage": "https://github.com/yohn-jp/suzukuri#readme",
  "bugs": {
    "url": "https://github.com/yohn-jp/suzukuri/issues"
  },
  "keywords": [
    "semantic",
    "projection",
    "cli"
  ]
}
